
fn decay(t, k)  = exp(-t * k)
fn perc(t, k)   = t * k * exp(1 - t * k)

fn ramp(t, len)    = clamp(t / len, 0, 1)
fn fall(t, len)    = clamp(1 - t / len, 0, 1)
fn ar(t, a, r)     = clamp(t / a, 0, 1) * clamp(1 - (t - a) / r, 0, 1)
fn ad(t, a, d)     = ar(t, a, d)

fn adsr(t, a, d, s, r, len) =
      clamp(t / a, 0, 1)
    * (1 - (1 - s) * clamp((t - a) / d, 0, 1))
    * clamp(1 - (t - len) / r, 0, 1)

fn lfo(x, rate)      = sin(2 * pi() * rate * x)        # -1..1 sine LFO
fn lfo_uni(x, rate)  = 0.5 + 0.5 * sin(2 * pi() * rate * x)   # 0..1
fn tremolo(y, x, rate, depth) = y * (1 - depth * lfo_uni(x, rate))
fn vibrato(freq, x, rate, depth) = freq * (1 + depth * lfo(x, rate))
